## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.user.*.resharper
*.sln.ide
.vs/*.suo
.vs/*.user
.vs-xml/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
ARM/
build/
[Oo]ut/
[Bb]in/
[Ll]ib/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.log
*.tlog
*.ilk
*.meta
*.pid
*.resources
*.res

# Visual C++ files
*.vc[op]proj
*.dir
*.master.details
*.pack
*.this.user
*.image.manifest
*.vspscc
*.vssscc
.builds
*.force.js
*.force.html
*.force.css
.config/
*.pfx
*.snk
ProjectName.WinMD
WinMdObj/

# The .vs folder
# The .vs folder contains user-specific, hidden files for the solution, 
# which should not be committed to source control.
.vs/
